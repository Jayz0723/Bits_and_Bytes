# No map API key or billing account is required for the default small-use map setup.
# Optional alternative Photon-compatible reverse endpoint:
# MAP_GEOCODER_URL=https://photon.komoot.io/reverse
# Optional replacement tile provider; retain its required attribution:
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
